{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=AiKnowledgeCopilotDb;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "AiKnowledgeCopilot",
    "Audience": "AiKnowledgeCopilot.Api",
    "SigningKey": "",
