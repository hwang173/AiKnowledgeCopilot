    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "EmbeddingModel": "text-embedding-3-small",
    "ChatModel": "gpt-4o-mini",
    "RequestTimeoutSeconds": 60,
    "MaxRetryAttempts": 3,
    "RetryBaseDelaySeconds": 2
  },

  "AllowedHosts": "*"
